{
  "name": "trd-terminal-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Professional Liquid Glass Trading Terminal Monorepo (Electron + Next.js)",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @trd/web dev",
    "dev:web": "pnpm --filter @trd/web dev",
    "dev:desktop": "pnpm --filter @trd/desktop dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @trd/web build",
    "build:desktop": "pnpm --filter @trd/desktop build",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "lint": "echo Workspaces checked",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run test/e2e"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
