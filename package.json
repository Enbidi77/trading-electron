{
  "name": "trd-terminal-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Professional Liquid Glass Desktop Trading Terminal",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @trd/desktop dev",
    "dev:web": "pnpm --filter @trd/desktop dev:web",
    "dev:electron": "pnpm --filter @trd/desktop dev:electron",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
